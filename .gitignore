!apps/desktop/build/
!apps/desktop/build/icon.png

# Binarios do extrator de voz: reconstituidos por scripts/fetch-voice-extractor.mjs
# (versao e hash fixados). Licencas e README ficam versionados.
vendor/csgo-voice-extractor/win32-x64/

# Icones de CS2 (propriedade da Valve, uso nao comercial): reconstituidos por
# scripts/fetch-cs-icons.mjs a partir do manifesto versionado. Ver NOTICE.
vendor/counter-strike-icons/*
!vendor/counter-strike-icons/manifest.json
!vendor/counter-strike-icons/LICENSE
