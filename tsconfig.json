{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": [
      "node",
      "vitest/globals"
    ]
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "scripts/**/*.ts",
    "apps/desktop/src/**/*.ts",
    "apps/desktop/test/**/*.ts",
    "apps/host/src/**/*.ts"
  ]
}
